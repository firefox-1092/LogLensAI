# Backend browser origins; comma-separated.
LOG_LENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local PostgreSQL container. Replace the password before starting the database.
POSTGRES_DB=loglens
POSTGRES_USER=loglens
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_HOST_PORT=5433

# Maximum uploaded file size in bytes (10 MiB).
LOG_LENS_MAX_UPLOAD_BYTES=10485760

# Frontend API endpoint (public browser configuration, never a secret).
VITE_API_BASE_URL=http://127.0.0.1:8000

# AI provider. Keep the default to preserve the existing Groq configuration.
LLM_PROVIDER=groq

# GroqCloud (used when LLM_PROVIDER=groq).
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter (used when LLM_PROVIDER=openrouter). Choose an available model ID.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
